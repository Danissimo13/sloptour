include("${RULES}")

set(folders "")
foreach(layer IN LISTS SLOPTOUR_LAYERS)
    list(APPEND folders "${SLOPTOUR_LAYER_FOLDER_${layer}}")
endforeach()

function(owner_of header output)
    set(owner "")
    set(owner_length 0)
    foreach(folder IN LISTS folders)
        string(LENGTH "${folder}" length)
        string(FIND "${header}" "${folder}/" position)
        if(position EQUAL 0 AND length GREATER owner_length)
            set(owner "${folder}")
            set(owner_length ${length})
        endif()
    endforeach()
    set(${output} "${owner}" PARENT_SCOPE)
endfunction()

set(violations "")
foreach(layer IN LISTS SLOPTOUR_LAYERS)
    set(folder "${SLOPTOUR_LAYER_FOLDER_${layer}}")
    file(GLOB_RECURSE sources "${SOURCE_DIR}/${folder}/*.hpp" "${SOURCE_DIR}/${folder}/*.cpp")
    foreach(excluded IN LISTS SLOPTOUR_LAYER_EXCLUDED_${layer})
        list(FILTER sources EXCLUDE REGEX "^${SOURCE_DIR}/${excluded}/")
    endforeach()
    foreach(source IN LISTS sources)
        file(STRINGS "${source}" includes REGEX "^#include \"")
        foreach(line IN LISTS includes)
            string(REGEX REPLACE "^#include \"([^\"]+)\".*$" "\\1" header "${line}")
            owner_of("${header}" owner)
            if(owner AND NOT owner IN_LIST SLOPTOUR_LAYER_ALLOWED_${layer})
                file(RELATIVE_PATH relative "${SOURCE_DIR}" "${source}")
                list(APPEND violations "${relative} includes ${header}: ${folder} does not depend on ${owner}")
            endif()
        endforeach()
    endforeach()
endforeach()

if(violations)
    list(JOIN violations "\n  " report)
    message(FATAL_ERROR "Layer rule violations:\n  ${report}")
endif()
